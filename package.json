{
  "name": "layout-generator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "build:native": "cmake -S . -B build -DCMAKE_BUILD_TYPE=Release && cmake --build build -j2",
    "build": "npm run build:native && tsc -p tsconfig.server.json && tsc --noEmit -p tsconfig.json && vite build",
    "start": "node dist-server/server/index.js",
    "dev": "npm run build && npm start",
    "test": "npm run build && node --test dist-server/tests/*.test.js"
  },
  "dependencies": {
    "csv-parse": "^7.0.3",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.187.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.0"
  }
}
