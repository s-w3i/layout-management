digraph G {

  graph [rankdir=TD, bgcolor="white", pad="0.35", nodesep="0.45", ranksep="0.55"];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=18, margin="0.18,0.12", color="#2563eb", fillcolor="#eff6ff", penwidth=2];
  edge [fontname="Arial", fontsize=14, color="#475569", arrowsize=0.8, penwidth=1.6];

  title [label="ABC + Affinity Blended Slotting Strategy", shape=box, style="rounded,filled", fillcolor="#1e3a8a", fontcolor="white", color="#1e3a8a", fontsize=24, margin="0.25,0.16"];

  start [label="Start slotting"];
  load [label="Load SKU velocity data"];
  abc [label="Classify SKU into ABC rank"];
  orders [label="Load order / transaction history"];
  graphnode [label="Build SKU affinity graph"];
  weights [label="Set weights"];
  abcw [label="ABC weight =\n1 - affinity weight"];
  affw [label="Affinity weight =\nuser setting"];
  abcscore [label="Calculate ABC score"];
  affscore [label="Calculate affinity score"];
  combined [label="Combined score =\nABC score × ABC weight\n+ affinity score × affinity weight", fillcolor="#eef2ff", color="#4f46e5"];
  sort [label="Select next SKU by\ncombined score"];
  candidate [label="Choose best rack / slot\nby combined score"];
  hard [label="Hard rules pass?", shape=diamond, fillcolor="#fef3c7", color="#d97706"];
  try [label="Try next candidate", fillcolor="#fff7ed", color="#ea580c"];
  place [label="Place SKU"];
  done [label="All SKU processed?", shape=diamond, fillcolor="#fef3c7", color="#d97706"];
  rank [label="Rank racks by assigned\npick frequency"];
  output [label="Output slotting layout", fillcolor="#dcfce7", color="#16a34a"];
  examples [label="Examples\n0% affinity = pure ABC\n70% affinity = 70 / 30\n100% affinity = pure affinity", fillcolor="#f8fafc", color="#64748b"];

  title -> start;
  start -> load -> abc -> orders -> graphnode -> weights;
  weights -> abcw -> abcscore -> combined;
  weights -> affw -> affscore -> combined;
  combined -> sort -> candidate -> hard;
  hard -> try [label="No"];
  try -> hard;
  hard -> place [label="Yes"];
  place -> done;
  done -> sort [label="No"];
  done -> rank [label="Yes"];
  rank -> output;
  weights -> examples [style=dashed, arrowhead=none];

}
