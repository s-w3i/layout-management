digraph G {

  graph [rankdir=TD, bgcolor="white", pad="0.35", nodesep="0.45", ranksep="0.55"];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=18, margin="0.18,0.12", color="#2563eb", fillcolor="#eff6ff", penwidth=2];
  edge [fontname="Arial", fontsize=14, color="#475569", arrowsize=0.8, penwidth=1.6];

  title [label="Pure Affinity Slotting Strategy", shape=box, style="rounded,filled", fillcolor="#1e3a8a", fontcolor="white", color="#1e3a8a", fontsize=24, margin="0.25,0.16"];

  start [label="Start slotting"];
  load [label="Load SKU velocity data"];
  orders [label="Load order / transaction history"];
  graphnode [label="Build SKU affinity graph"];
  strength [label="Calculate affinity strength\nbetween SKU pairs"];
  seed [label="Select first SKU by\nstrongest affinity seed"];
  nextsku [label="Select next SKU by strongest\nconnection to placed SKU"];
  candidate [label="Choose rack / slot closest\nto related assigned SKU"];
  hard [label="Hard rules pass?", shape=diamond, fillcolor="#fef3c7", color="#d97706"];
  try [label="Try next valid\naffinity candidate", fillcolor="#fff7ed", color="#ea580c"];
  place [label="Place SKU"];
  near [label="Related SKU nearby /\nsame rack possible?", shape=diamond, fillcolor="#fef3c7", color="#d97706"];
  same [label="Prefer same rack\nor nearby rack"];
  best [label="Use best valid\naffinity candidate"];
  done [label="All SKU processed?", shape=diamond, fillcolor="#fef3c7", color="#d97706"];
  rank [label="Rank racks by assigned\npick frequency"];
  output [label="Output slotting layout", fillcolor="#dcfce7", color="#16a34a"];
  note [label="affinity weight = 100%\nABC weight = 0%\nABC does not drive ordering", fillcolor="#f8fafc", color="#64748b"];

  title -> start;
  start -> load -> orders -> graphnode -> strength -> seed -> nextsku -> candidate -> hard;
  hard -> try [label="No"];
  try -> hard;
  hard -> place [label="Yes"];
  place -> near;
  near -> same [label="Yes"];
  near -> best [label="No"];
  same -> done;
  best -> done;
  done -> nextsku [label="No"];
  done -> rank [label="Yes"];
  rank -> output;
  seed -> note [style=dashed, arrowhead=none];

}
